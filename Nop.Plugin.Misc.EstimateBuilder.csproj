<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Nop.Plugin.Misc.EstimateBuilder</AssemblyName>
    <RootNamespace>Nop.Plugin.Misc.EstimateBuilder</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <OutputPath>../output</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Folder holding the nopCommerce 4.90 assemblies; override with -p:NopRefs=<path> -->
    <NopRefs Condition="'$(NopRefs)' == ''">../refs</NopRefs>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Nop.Core">
      <HintPath>$(NopRefs)/Nop.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Nop.Data">
      <HintPath>$(NopRefs)/Nop.Data.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Nop.Services">
      <HintPath>$(NopRefs)/Nop.Services.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Nop.Web.Framework">
      <HintPath>$(NopRefs)/Nop.Web.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Nop.Web">
      <HintPath>$(NopRefs)/Nop.Web.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FluentMigrator">
      <HintPath>$(NopRefs)/FluentMigrator.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FluentMigrator.Abstractions">
      <HintPath>$(NopRefs)/FluentMigrator.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FluentMigrator.Runner.Core">
      <HintPath>$(NopRefs)/FluentMigrator.Runner.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="linq2db">
      <HintPath>$(NopRefs)/linq2db.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ClosedXML">
      <HintPath>$(NopRefs)/ClosedXML.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="iTextSharp.LGPLv2.Core">
      <HintPath>$(NopRefs)/iTextSharp.LGPLv2.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="logo.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Views\**\*.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
