@model Nop.Plugin.Misc.EstimateBuilder.Models.EstimateItemsModel

@{
    Layout = "_ColumnsOne";
    NopHtml.AddTitleParts("Estimate Items");
    NopHtml.AppendPageCssClassParts("html-account-page");
}

<div class="page account-page estimate-items-page">
    <style>
        /* The theme's .page-title:after clearfix would become a third flex item and push the buttons to the middle */
        .estimate-page-title { display:flex; flex-wrap:wrap; gap:8px; justify-content:space-between; align-items:center; border-bottom:2px solid #3a7bbf; padding-bottom:8px; margin-bottom:16px; text-align:left; }
        .estimate-page-title::after { display:none; }
    </style>
    <div class="page-title estimate-page-title">
        <h1 style="margin:0;">Estimate Items</h1>
        <div>
            <a href="@Url.Action("Create","Estimate")" class="button-1" style="background:#3a7bbf; color:#fff; padding:8px 16px; text-decoration:none; border-radius:3px; margin-right:8px;">
                &#43; Add Estimate
            </a>
            <a href="@Url.Action("Index","Estimate")" class="button-2" style="background:#888; color:#fff; padding:8px 16px; text-decoration:none; border-radius:3px;">
                &#171;&#171; Back To List
            </a>
        </div>
    </div>

    <div class="page-body">
        <form asp-action="UpdateItems" asp-controller="Estimate" method="post">
            <input type="hidden" asp-for="EstimateListId" />

            <div style="display:flex; gap:40px; margin-bottom:16px;">
                <div style="flex:1;">
                    <label style="font-weight:bold;">Estimate Name:</label><br />
                    <input asp-for="EstimateName" style="width:100%; padding:6px; border:1px solid #ccc; background:#fff; color:#333; font-size:14px;" />
                </div>
                <div style="flex:2;">
                    <label style="font-weight:bold;">Description:</label><br />
                    <textarea asp-for="Description" rows="3" style="width:100%; padding:6px; border:1px solid #ccc; background:#fff; color:#333; font-size:14px;"></textarea>
                </div>
            </div>

            <div style="border-bottom:2px solid #3a7bbf; margin-bottom:16px;"></div>

            @*-- Add Product --*@
            <div style="background:#f7f9fc; border:1px solid #dde3ed; border-radius:4px; padding:14px 16px; margin-bottom:16px;">
                <h4 style="margin:0 0 10px; font-size:14px; font-weight:bold; color:#333;">Add Product</h4>
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    <input type="search" id="add-product-search" placeholder="Search name or SKU..." autocomplete="off"
                           style="padding:6px 10px; border:1px solid #ccc; min-width:200px; color:#333; font-size:14px; background:#fff;" />
                    <select id="add-category-select"
                            style="padding:6px 10px; border:1px solid #ccc; min-width:220px; color:#333; font-size:14px; background:#fff;">
                        <option value="">-- All Categories --</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                    <select id="add-product-select" disabled onchange="loadAttributesForProduct()"
                            style="padding:6px 10px; border:1px solid #ccc; min-width:240px; color:#333; font-size:14px; background:#fff;">
                        <option value="">-- Select Product --</option>
                    </select>
                    <input type="number" id="add-product-qty" value="1" min="1" max="@EstimateBuilderDefaults.MaxQuantity"
                           style="width:60px; padding:6px; border:1px solid #ccc; text-align:center; font-size:14px; color:#333; background:#fff;" />
                    <button type="button" onclick="addProductFromDetail()"
                            style="background:#3a7bbf; color:#fff; padding:6px 16px; border:none; cursor:pointer; border-radius:3px; font-size:14px;">
                        + Add
                    </button>
                </div>
                <div id="add-attr-panel" style="display:none; margin-top:12px; border-top:1px solid #dde3ed; padding-top:10px;"></div>
                <p id="add-product-msg" style="margin:8px 0 0; font-size:13px; color:#333; display:none;"></p>
            </div>

            <div style="border-bottom:2px solid #3a7bbf; margin-bottom:16px;"></div>
            <div style="text-align:center; margin-bottom:16px;">
                <button type="submit" class="button-1" style="background:#3a7bbf; color:#fff; padding:8px 20px; border:none; cursor:pointer; border-radius:3px;">
                    &#10003; Update
                </button>
            </div>

            @if (!Model.Items.Any())
            {
                <p>Your Estimate List Is Empty!</p>
            }
            else
            {
                <table style="width:100%; border-collapse:collapse; margin-bottom:16px;">
                    <thead>
                        <tr style="background:#f2f2f2;">
                            <th style="padding:10px; border:1px solid #ddd; text-align:left;">Remove</th>
                            <th style="padding:10px; border:1px solid #ddd; text-align:left;">SKU</th>
                            <th style="padding:10px; border:1px solid #ddd; text-align:left;">Image</th>
                            <th style="padding:10px; border:1px solid #ddd; text-align:left;">Product(s)</th>
                            @if (Model.ShowPrices)
                            {
                                <th style="padding:10px; border:1px solid #ddd; text-align:right;">Price</th>
                            }
                            <th style="padding:10px; border:1px solid #ddd; text-align:center;">Qty.</th>
                            @if (Model.ShowPrices)
                            {
                                <th style="padding:10px; border:1px solid #ddd; text-align:right;">Total</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            <tr>
                                <input type="hidden" name="Items[@i].Id" value="@Model.Items[i].Id" />
                                <input type="hidden" name="Items[@i].ProductId" value="@Model.Items[i].ProductId" />
                                <td style="padding:8px 10px; border:1px solid #ddd; text-align:center;">
                                    <input type="checkbox" name="Items[@i].Remove" value="true" />
                                </td>
                                <td style="padding:8px 10px; border:1px solid #ddd;">@Model.Items[i].Sku</td>
                                <td style="padding:8px 10px; border:1px solid #ddd;">
                                    @if (!string.IsNullOrEmpty(Model.Items[i].ImageUrl))
                                    {
                                        <img src="@Model.Items[i].ImageUrl" alt="@Model.Items[i].ProductName" style="max-width:75px;" />
                                    }
                                </td>
                                <td style="padding:8px 10px; border:1px solid #ddd; font-weight:bold;">
                                    <a href="@Model.Items[i].ProductUrl" style="color:#3a7bbf; text-decoration:none;">@Model.Items[i].ProductName</a>
                                    @if (!string.IsNullOrEmpty(Model.Items[i].AttributesFormatted))
                                    {
                                        <div style="font-weight:normal; font-size:12px; color:#666; margin-top:3px;">@Model.Items[i].AttributesFormatted</div>
                                    }
                                </td>
                                @if (Model.ShowPrices)
                                {
                                    <td style="padding:8px 10px; border:1px solid #ddd; text-align:right;">@Model.Items[i].PriceFormatted</td>
                                }
                                <td style="padding:8px 10px; border:1px solid #ddd; text-align:center;">
                                    <input type="number" name="Items[@i].Quantity" value="@Model.Items[i].Quantity" min="1" style="width:60px; text-align:center; border:1px solid #ccc; padding:4px; background:#fff; color:#333; font-size:14px;" />
                                </td>
                                @if (Model.ShowPrices)
                                {
                                    <td style="padding:8px 10px; border:1px solid #ddd; text-align:right;">@Model.Items[i].TotalFormatted</td>
                                }
                            </tr>
                        }
                    </tbody>
                    @if (Model.ShowPrices)
                    {
                        <tfoot>
                            <tr>
                                <td colspan="6" style="padding:8px 10px; border:1px solid #ddd; text-align:right; font-weight:bold;">Sub Total</td>
                                <td style="padding:8px 10px; border:1px solid #ddd; text-align:right; font-weight:bold;">@Model.SubTotalFormatted</td>
                            </tr>
                        </tfoot>
                    }
                </table>

                <div style="display:flex; gap:8px; justify-content:center; flex-wrap:wrap; margin-top:16px;">
                    <button type="button" onclick="estimateAddToCart()" style="background:#4a3d8f; color:#fff; padding:10px 16px; border:none; cursor:pointer; border-radius:3px;">
                        &#128722; Add To Cart
                    </button>

                    <button type="submit" style="background:#3a7bbf; color:#fff; padding:10px 16px; border:none; cursor:pointer; border-radius:3px;">
                        &#10003; Update Estimate Items
                    </button>

                    <button type="button" onclick="estimateDeleteList()" style="background:#c0392b; color:#fff; padding:10px 16px; border:none; cursor:pointer; border-radius:3px;">
                        &#128465; Delete Estimate List
                    </button>

                    <a href="@Url.Action("ExportToExcel","Estimate", new { id = Model.EstimateListId })"
                       style="background:#1e7e34; color:#fff; padding:10px 16px; text-decoration:none; border-radius:3px; display:inline-flex; align-items:center;">
                        &#128196; Export To Excel
                    </a>

                    <a href="@Url.Action("ExportToPdf","Estimate", new { id = Model.EstimateListId })"
                       style="background:#155724; color:#fff; padding:10px 16px; text-decoration:none; border-radius:3px; display:inline-flex; align-items:center;">
                        &#128196; Export To PDF
                    </a>
                </div>
            }
        </form>

        <form id="estimate-addtocart-form" action="@Url.Action("AddToCart","Estimate", new { id = Model.EstimateListId })" method="post" style="display:none;">
            @Html.AntiForgeryToken()
        </form>
        <form id="estimate-deletelist-form" action="@Url.Action("Delete","Estimate", new { id = Model.EstimateListId })" method="post" style="display:none;">
            @Html.AntiForgeryToken()
        </form>

        <style>
            .estimate-attr-group { margin-top:8px; display:flex; flex-direction:column; gap:10px; }
            .estimate-attr-label { font-size:13px; font-weight:bold; color:#333; }
            .estimate-attr-input { padding:5px; border:1px solid #ccc; font-size:13px; color:#333; background:#fff; margin-top:3px; min-width:220px; }
            .estimate-attr-option { margin-right:12px; font-size:13px; }
        </style>
        <script src="@Url.Content(EstimateBuilderDefaults.ScriptPath)"></script>
        <script>
            function estimateAddToCart() {
                document.getElementById('estimate-addtocart-form').submit();
            }
            function estimateDeleteList() {
                if (confirm('Delete this estimate list?'))
                    document.getElementById('estimate-deletelist-form').submit();
            }

            EstimateBuilder.productPicker({
                url: '@Url.Action("GetProductsByCategory", "Estimate")',
                categoryId: 'add-category-select',
                searchId: 'add-product-search',
                productId: 'add-product-select',
                onReset: function () {
                    var panel = document.getElementById('add-attr-panel');
                    panel.style.display = 'none';
                    panel.innerHTML = '';
                }
            });

            function loadAttributesForProduct() {
                var productId = document.getElementById('add-product-select').value;
                var panel = document.getElementById('add-attr-panel');
                panel.innerHTML = '';
                panel.style.display = 'none';
                if (!productId) return;
                fetch('@Url.Action("GetProductAttributes", "Estimate")?productId=' + encodeURIComponent(productId))
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (!data.hasAttributes) return;
                        EstimateBuilder.renderAttributes(panel, data.attributes, {
                            group: 'estimate-attr-group',
                            label: 'estimate-attr-label',
                            select: 'estimate-attr-input',
                            input: 'estimate-attr-input',
                            textarea: 'estimate-attr-input',
                            option: 'estimate-attr-option'
                        }, false);
                    });
            }

            function addProductFromDetail() {
                var productId = document.getElementById('add-product-select').value;
                var qty = parseInt(document.getElementById('add-product-qty').value, 10) || 1;
                var msg = document.getElementById('add-product-msg');
                if (!productId) {
                    msg.textContent = 'Please select a product.';
                    msg.style.display = 'block';
                    msg.style.color = '#c0392b';
                    return;
                }
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var params = new URLSearchParams();
                params.append('productId', productId);
                params.append('estimateListId', '@(Model.EstimateListId)');
                params.append('quantity', qty);
                EstimateBuilder.appendAttributes(document.getElementById('add-attr-panel'), params);
                fetch('@Url.Action("AddToEstimate", "Estimate")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: params.toString()
                })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    msg.textContent = data.message;
                    msg.style.color = data.success ? '#1e7e34' : '#c0392b';
                    msg.style.display = 'block';
                    if (data.success) {
                        setTimeout(function() { location.reload(); }, 800);
                    }
                });
            }
        </script>
    </div>
</div>
